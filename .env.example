# Nueva version solamente. No usar credenciales reales en el repositorio.
# Valores validos sugeridos: local, staging, production.
ULTIMOTURNO_ENV=local

# Produccion debe definir el/los dominios reales que pueden llamar a la API.
# Ejemplo: https://app.ultimoturno.com,https://admin.ultimoturno.com
ULTIMOTURNO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave temporal para piloto privado. En ecommerce se reemplaza por usuarios/sesiones reales.
ULTIMOTURNO_ACCESS_KEY=cambiar_en_cada_ambiente

# Base local actual. Produccion debe usar ULTIMOTURNO_DB_DRIVER=postgres.
ULTIMOTURNO_DB_DRIVER=pglite
DATABASE_URL=postgres://postgres:postgres@localhost:54322/ultimoturno_local
ULTIMOTURNO_DATABASE_SSL=false
ULTIMOTURNO_DATABASE_POOL_MAX=10
ULTIMOTURNO_SCHEMA_CONFIRM=
ULTIMOTURNO_MIGRATION_CONFIRM=
API_PORT=4000
ADMIN_WEB_PORT=5173
PGLITE_DATA_DIR=.data/ultimoturno-pglite
VITE_API_BASE_URL=/api

PRICECHARTING_TOKEN=pegar_solo_en_el_entorno_local
PRICECHARTING_CATEGORY=pokemon-cards
PRICECHARTING_IMAGE_DIR=D:\UltimoTurno\pricecharting-images

# Preparacion ecommerce/pagos. Mantener en blanco hasta integrar el proveedor elegido.
ULTIMOTURNO_PUBLIC_APP_URL=http://localhost:5173
ULTIMOTURNO_CHECKOUT_PROVIDER=manual
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
