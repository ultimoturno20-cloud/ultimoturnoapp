{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "apps/admin-web/dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/admin" }
      ]
    },
    {
      "source": "/admin/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/inicio", "destination": "/admin", "permanent": true },
    { "source": "/inventario", "destination": "/admin/inventario", "permanent": true },
    { "source": "/inventario/:path*", "destination": "/admin/inventario/:path*", "permanent": true },
    { "source": "/ordenes", "destination": "/admin/ordenes", "permanent": true },
    { "source": "/caja", "destination": "/admin/caja", "permanent": true },
    { "source": "/claims", "destination": "/admin/claims", "permanent": true },
    { "source": "/claims/:path*", "destination": "/admin/claims/:path*", "permanent": true },
    { "source": "/compras", "destination": "/admin/compras", "permanent": true },
    { "source": "/calidad", "destination": "/admin/calidad", "permanent": true },
    { "source": "/movimientos", "destination": "/admin/movimientos", "permanent": true },
    { "source": "/importar", "destination": "/admin/importar", "permanent": true },
    { "source": "/carga-movil", "destination": "/admin/carga-movil", "permanent": true },
    { "source": "/revendedores", "destination": "/admin/revendedores", "permanent": true },
    { "source": "/admin/inicio", "destination": "/admin", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true },
    { "source": "/tienda", "destination": "/", "permanent": true },
    { "source": "/manifest.webmanifest", "destination": "/admin/manifest.webmanifest", "permanent": true }
  ],
  "rewrites": [
    { "source": "/pricecharting-images/:path*", "destination": "/api/dispatch?path=/pricecharting-images/:path*" },
    { "source": "/api/tournament-space/:path*", "destination": "/api/dispatch?path=/tournament-space/:path*" },
    { "source": "/api/tournaments", "destination": "/api/dispatch?path=/tournaments" },
    { "source": "/api/tournaments/:path*", "destination": "/api/dispatch?path=/tournaments/:path*" },
    { "source": "/api/auth/:path*", "destination": "/api/dispatch?path=/auth/:path*" },
    { "source": "/api/mobile-intake/:path*", "destination": "/api/dispatch?path=/mobile-intake/:path*" },
    { "source": "/api/stock-images/:path*", "destination": "/api/dispatch?path=/stock-images/:path*" },
    { "source": "/api/inventory/:path*", "destination": "/api/dispatch?path=/inventory/:path*" },
    { "source": "/api/sales/:path*", "destination": "/api/dispatch?path=/sales/:path*" },
    { "source": "/api/sale-items/:path*", "destination": "/api/dispatch?path=/sale-items/:path*" },
    { "source": "/api/claim-plans/:path*", "destination": "/api/dispatch?path=/claim-plans/:path*" },
    { "source": "/api/claims/:path*", "destination": "/api/dispatch?path=/claims/:path*" },
    { "source": "/api/card-index/:path*", "destination": "/api/dispatch?path=/card-index/:path*" },
    { "source": "/api/coolstuff-prices/:path*", "destination": "/api/dispatch?path=/coolstuff-prices/:path*" },
    { "source": "/api/cron/:path*", "destination": "/api/dispatch?path=/cron/:path*" },
    { "source": "/api/database-quality/:path*", "destination": "/api/dispatch?path=/database-quality/:path*" },
    { "source": "/api/pricecharting-cache/:path*", "destination": "/api/dispatch?path=/pricecharting-cache/:path*" },
    { "source": "/api/pricecharting-images/:path*", "destination": "/api/dispatch?path=/pricecharting-images/:path*" },
    { "source": "/api/tcgplayer-prices/:path*", "destination": "/api/dispatch?path=/tcgplayer-prices/:path*" },
    { "source": "/api/exchange-rate/:path*", "destination": "/api/dispatch?path=/exchange-rate/:path*" },
    { "source": "/api/examples/:path*", "destination": "/api/dispatch?path=/examples/:path*" },
    { "source": "/api/imports/:path*", "destination": "/api/dispatch?path=/imports/:path*" },
    { "source": "/torneos", "destination": "/torneos.html" },
    { "source": "/torneos/", "destination": "/torneos.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin/inventario", "destination": "/admin.html" },
    { "source": "/admin/inventario/:path*", "destination": "/admin.html" },
    { "source": "/admin/ordenes", "destination": "/admin.html" },
    { "source": "/admin/caja", "destination": "/admin.html" },
    { "source": "/admin/claims", "destination": "/admin.html" },
    { "source": "/admin/claims/:path*", "destination": "/admin.html" },
    { "source": "/admin/compras", "destination": "/admin.html" },
    { "source": "/admin/calidad", "destination": "/admin.html" },
    { "source": "/admin/movimientos", "destination": "/admin.html" },
    { "source": "/admin/importar", "destination": "/admin.html" },
    { "source": "/admin/carga-movil", "destination": "/admin.html" },
    { "source": "/admin/revendedores", "destination": "/admin.html" },
    { "source": "/admin/configuracion", "destination": "/admin.html" },
    { "source": "/portal-revendedor", "destination": "/admin.html" },
    { "source": "/portal-revendedor/:path*", "destination": "/admin.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "packages/db/{migrations,seeds}/**",
      "maxDuration": 300
    }
  }
}
